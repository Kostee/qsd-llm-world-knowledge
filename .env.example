# --- OpenAI ---
OPENAI_API_KEY=your_key_here

# --- Alibaba DashScope / Qwen ---
QWEN_API_KEY=your_key_here

# --- OpenRouter (Llama models in the final paper sweep) ---
OPENROUTER_API_KEY=your_key_here

# --- Google Gemini (optional; not required for the final seven-model paper sweep) ---
GOOGLE_API_KEY=your_key_here

# --- Optional RAG configuration ---
# Must match the embedding model used to build the FAISS index.
# RAG_DIR=data/private/rag_corpus
# RAG_PASSAGES_BASENAME=wiki_passages
# RAG_EMBEDDING_MODEL=sentence-transformers/multi-qa-mpnet-base-dot-v1
# RAG_TOP_K=3
# RAG_MAX_CONTEXT_CHARS=1200
# RAG_MAX_PASSAGE_CHARS=400

# --- Optional runtime controls ---
# LLM_REQUEST_TIMEOUT_S=90
# GEMINI_MIN_REQUEST_INTERVAL_S=6.6
